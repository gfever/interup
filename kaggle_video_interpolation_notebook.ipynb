{
 "cells": [
  {
   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Интерполяция видео до 60 FPS — блокнот для Kaggle\\n\",\n",
    "    \"\\n\",\n",
    "    \"Этот блокнот делает 2 варианта интерполяции кадров до 60 fps:\\n\",\n",
    "    \"\\n\",\n",
    "    \"1. Быстрый и надёжный метод — ffmpeg `minterpolate` (работает без установки DL-зависимостей).\\n\",\n",
    "    \"2. Опционально: более качественный DL-подход на базе RIFE (если хотите — можно запустить; требует загрузки репозитория и весов и GPU).\\n\",\n",
    "    \"\\n\",\n",
    "    \"Использование: загрузите видео (любого разрешения до 4K) через Kaggle UI в `/kaggle/working/input/` или поместите его в `/kaggle/input/` (если сделали Dataset).\\n\",\n",
    "    \"\\n\",\n",
    "    \"---\\n\",\n",
    "    \"\\n\",\n",
    "    \"Ниже — пошаговый план и ячейки, которые нужно выполнить сверху вниз.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## План (чеклист)\\n\",\n",
    "    \"- [ ] Проверить окружение (GPU, ffmpeg).\\n\",\n",
    "    \"- [ ] Поместить видео в `/kaggle/working/input/` или указать путь.\\n\",\n",
    "    \"- [ ] Запустить ffmpeg-интерполяцию (быстро, baseline).\\n\",\n",
    "    \"- [ ] Опционально: запустить RIFE для более качественной интерполяции (если нужен лучший результат и вы готовы ждать).\\n\",\n",
    "    \"- [ ] Скачать/посмотреть результат в `/kaggle/working/output/`.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Ячейка 1 — базовая проверка окружения\\n\",\n",
    "    \"import os, sys, shutil, subprocess, json\\n\",\n",
    "    \"print('Python:', sys.version.split('\\\\n')[0])\\n\",\n",
    "    \"# Проверяем наличие GPU (CUDA)\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    import torch\\n\",\n",
    "    \"    print('torch version:', torch.__version__)\\n\",\n",
    "    \"    print('CUDA available:', torch.cuda.is_available())\\n\",\n",
    "    \"    if torch.cuda.is_available():\\n\",\n",
    "    \"        print('CUDA device count:', torch.cuda.device_count())\\n\",\n",
    "    \"        print('Current device:', torch.cuda.current_device())\\n\",\n",
    "    \"except Exception as e:\\n\",\n",
    "    \"    print('torch not available or import failed:', e)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Проверяем ffmpeg\\n\",\n",
    "    \"def has_ffmpeg():\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        subprocess.run([\\n\",\n",
    "    \"            'ffmpeg','-version'\\n\",\n",
    "    \"        ], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)\\n\",\n",
    "    \"        return True\\n\",\n",
    "    \"    except Exception:\\n\",\n",
    "    \"        return False\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('ffmpeg present:', has_ffmpeg())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Создаём папки для ввода/вывода\\n\",\n",
    "    \"os.makedirs('/kaggle/working/input', exist_ok=True)\\n\",\n",
    "    \"os.makedirs('/kaggle/working/output', exist_ok=True)\\n\",\n",
    "    \"print('Папки /kaggle/working/input и /kaggle/working/output готовы.')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Инструкция: добавьте файл видео\\n\",\n",
    "    \"\\n\",\n",
    "    \"Загрузите ваше видео через панель `Data` -> `Add or upload your data` в Kaggle или перетащите в `/kaggle/working/input/`.\\n\",\n",
    "    \"Укажите имя файла ниже и выполните следующие ячейки.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Ячейка 2 — параметры. Укажите имя входного файла (поместите его в /kaggle/working/input/)\\n\",\n",
    "    \"INPUT_FILENAME = 'input_video.mp4'  # <-- поменяйте на имя вашего файла\\n\",\n",
    "    \"INPUT_PATH = f'/kaggle/working/input/{INPUT_FILENAME}'\\n\",\n",
    "    \"OUTPUT_PATH_FFMPEG = '/kaggle/working/output/video_60fps_ffmpeg.mp4'\\n\",\n",
    "    \"print('INPUT_PATH =', INPUT_PATH)\\n\",\n",
    "    \"print('Если файла нет, загрузите его через Kaggle Data UI в /kaggle/working/input/')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Быстрая интерполяция — ffmpeg `minterpolate`\\n\",\n",
    "    \"Этот метод не требует DL-зависимостей. Качество среднее, но обычно подходит для быстрого результата.\\n\",\n",
    "    \"Команда использует `mi_mode=mci` и генерирует 60 fps.\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Ячейка 3 — запуск ffmpeg minterpolate\\n\",\n",
    "    \"import shlex, subprocess, os\\n\",\n",
    "    \"if not os.path.exists(INPUT_PATH):\\n\",\n",
    "    \"    raise FileNotFoundError(f'Входной файл не найден: {INPUT_PATH} — загрузите файл в /kaggle/working/input/')\\n\",\n",
    "    \"\\n\",\n",
    "    \"ffmpeg_cmd = [\\n\",\n",
    "    \"    'ffmpeg', '-y', '-i', INPUT_PATH,\\n\",\n",
    "    \"    '-vf', \"minterpolate='mi_mode=mci:mc_mode=aobmc:vsbmc=1:fps=60'\",\\n\",\n",
    "    \"    '-c:v', 'libx264', '-preset', 'veryslow', '-crf', '18',\\n\",\n",
    "    \"    OUTPUT_PATH_FFMPEG\\n\",\n",
    "    \"]\\n\",\n",
    "    \"print('Запуск ffmpeg... (это может занять время)')\\n\",\n",
    "    \"print(' '.join(shlex.quote(x) for x in ffmpeg_cmd))\\n\",\n",
    "    \"subprocess.run(ffmpeg_cmd, check=True)\\n\",\n",
    "    \"print('Готово. Выходный файл:', OUTPUT_PATH_FFMPEG)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Опционально: RIFE (DL) — лучшее качество\\n\",\n",
    "    \"Если вам нужно более плавное и качественное движение, используйте RIFE. Это требует GPU и загрузки репозитория с весами. Ниже — автоматизированные команды, которые можно запустить в ноутбуке (интернет разрешён).\\n\",\n",
    "    \"\\n\",\n",
    "    \"Внимание: установка и запуск RIFE занимает много времени и места. Запускайте только если в сессии есть GPU и вы готовы ждать.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Ячейка 4 — инструкции для RIFE (выполнять по желанию)\\n\",\n",
    "    \"rife_instructions = r'''\\n\",\n",
    "    \"# 1) Клонировать репозиторий RIFE (пример repo: hzwer/arXiv2019-RIFE)\\n\",\n",
    "    \"!git clone https://github.com/hzwer/arXiv2019-RIFE.git\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 2) Установить зависимости (может потребоваться корректировка)\\n\",\n",
    "    \"!pip install -r arXiv2019-RIFE/requirements.txt\\n\",\n",
    "    \"\\n\",\n",
    "    \"# 3) Скачать предобученные веса (примеры в README репо). Например:\\n\",\n",
    "    \"# (можно посмотреть README репо для актуальных ссылок)\\n\",\n",
    "    \"# 4) Запустить интерполяцию (пример):\\n\",\n",
    "    \"!python arXiv2019-RIFE/inference_video.py --exp=slomo --video \\\"/kaggle/working/input/INPUT_FILENAME\\\" --output \\\"/kaggle/working/output/video_60fps_rife.mp4\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ПРИМЕЧАНИЕ: замените INPUT_FILENAME на имя вашего файла.\\n\",\n",
    "    \"'''\\n\",\n",
    "    \"print(rife_instructions)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Ячейка X — определение GPU/VRAM и подбор параметров для RIFE / Real-ESRGAN\\n\",\n",
    "    \"import torch, os, math\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_vram_gb():\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        props = torch.cuda.get_device_properties(0)\\n\",\n",
    "    \"        return props.total_memory / (1024**3)\\n\",\n",
    "    \"    except Exception:\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"vram = get_vram_gb()\\n\",\n",
    "    \"gpu_name = None\\n\",\n",
    "    \"if vram is not None:\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        gpu_name = torch.cuda.get_device_name(torch.cuda.current_device())\\n\",\n",
    "    \"    except Exception:\\n\",\n",
    "    \"        gpu_name = 'unknown'\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Detected GPU:', gpu_name)\\n\",\n",
    "    \"print('Detected VRAM (GB):', None if vram is None else round(vram,2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Рекомендации (настроены для RTX 2060 Mobile 6GB)\\n\",\n",
    "    \"if vram is None:\\n\",\n",
    "    \"    RIFE_PARAMS = {'use_fp16': False, 'batch': 1, 'note': 'No GPU detected — используйте ffmpeg baseline или запустите на GPU-сервере'}\\n\",\n",
    "    \"    REAL_ESRGAN_PARAMS = {'tile': 400, 'tile_pad': 10, 'fp16': False, 'batch': 1}\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    if vram <= 6.5:\\n\",\n",
    "    \"        # целевая ветка для RTX 2060 Mobile 6GB\\n\",\n",
    "    \"        RIFE_PARAMS = {'use_fp16': True, 'batch': 1, 'note': 'RTX 2060 (~6GB): используйте fp16, batch=1. Для 4K применяйте тайлинг или предварительно уменьшайте до 1080p.'}\\n\",\n",
    "    \"        REAL_ESRGAN_PARAMS = {'tile': 400, 'tile_pad': 10, 'fp16': True, 'batch': 1}\\n\",\n",
    "    \"    elif vram <= 11:\\n\",\n",
    "    \"        RIFE_PARAMS = {'use_fp16': True, 'batch': 1, 'note': 'GPU среднего класса: fp16, batch=1'}\\n\",\n",
    "    \"        REAL_ESRGAN_PARAMS = {'tile': 512, 'tile_pad': 16, 'fp16': True, 'batch': 2}\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        RIFE_PARAMS = {'use_fp16': False, 'batch': 2, 'note': 'много VRAM'}\\n\",\n",
    "    \"        REAL_ESRGAN_PARAMS = {'tile': 0, 'tile_pad': 0, 'fp16': False, 'batch': 4}\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\nRIFE параметры (рекомендуемые):')\\n\",\n",
    "    \"for k,v in RIFE_PARAMS.items():\\n\",\n",
    "    \"    print(' ',k,':',v)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\nReal-ESRGAN параметры (рекомендуемые):')\\n\",\n",
    "    \"for k,v in REAL_ESRGAN_PARAMS.items():\\n\",\n",
    "    \"    print(' ',k,':',v)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Полезные генераторы команд (шаблоны)\\n\",\n",
    "    \"def make_rife_cmd(input_path, output_path, use_fp16):\\n\",\n",
    "    \"    cmd = f'python arXiv2019-RIFE/inference_video.py --exp=slomo --video \"{input_path}\" --output \"{output_path}\"'\\n\",\n",
    "    \"    if use_fp16:\\n\",\n",
    "    \"        cmd += ' --fp16'\\n\",\n",
    "    \"    return cmd\\n\",\n",
    "    \"\\n\",\n",
    "    \"def make_realesrgan_cmd(frames_dir, out_dir, tile, tile_pad, fp16):\\n\",\n",
    "    \"    # Пример для Python-скрипта inference_realesrgan.py из репо Real-ESRGAN\\n\",\n",
    "    \"    parts = [ 'python', 'inference_realesrgan.py', '--input', f'\"{frames_dir}\"', '--output', f'\"{out_dir}\"', '--model', 'RealESRGAN_x4plus' ]\\n\",\n",
    "    \"    if tile and tile > 0:\\n\",\n",
    "    \"        parts += ['--tile', str(tile), '--tile_pad', str(tile_pad)]\\n\",\n",
    "    \"    if fp16:\\n\",\n",
    "    \"        parts.append('--fp16')\\n\",\n",
    "    \"    return ' '.join(parts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Вывод примера команд с подобранными параметрами\\n\",\n",
    "    \"print('\\nПример команды RIFE (с вашими параметрами):')\\n\",\n",
    "    \"print(' ', make_rife_cmd('/kaggle/working/input/input_video.mp4', '/kaggle/working/output/video_60fps_rife.mp4', RIFE_PARAMS.get('use_fp16', False)))\\n\",\n",
    "    \"print('\\nПример команды Real-ESRGAN (для обработки кадров):')\\n\",\n",
    "    \"print(' ', make_realesrgan_cmd('/kaggle/working/frames', '/kaggle/working/upscaled_frames', REAL_ESRGAN_PARAMS['tile'], REAL_ESRGAN_PARAMS['tile_pad'], REAL_ESRGAN_PARAMS.get('fp16', False)))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('\\nСовет: прежде чем обрабатывать всё видео, протестируйте на 10-30 кадрах, чтобы подобрать tile и проверить артефакты.')\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Что дальше и советы\\n\",\n",
    "    \"- Если вы хотите сразу апскейлить до 4K после интерполяции — сначала доведите до 60 fps, затем апскейл на кадрах (Real-ESRGAN) с тайлингом.\\n\",\n",
    "    \"- Для длинных видео (несколько минут) выполняйте обработку по частям, чтобы не исчерпать дисковое пространство и память.\\n\",\n",
    "    \"- Могу дополнить блокнот ячейками для апскейла (Real-ESRGAN) — скажите, когда будете готовы.\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
